import {
  "caiklonghuan/MoonParse/grammar",
  "caiklonghuan/MoonParse/tablegen",
  "caiklonghuan/MoonParse/runtime",
  "caiklonghuan/MoonParse/grammars",
  "moonbitlang/core/env",
  "moonbitlang/core/bench",
}

options(
  "is-main": true,
  targets: {
    "exit_native.mbt": [ "native", "llvm" ],
    "exit_wasm.mbt": [ "wasm", "wasm-gc" ],
    "exit_js.mbt": [ "js" ],
  },
)
