{
  "schemaVersion": 1,
  "modulePrefix": "caiklonghuan/MoonParse",
  "ignoredDirectories": [".git", "_build", "build", "dist", "node_modules", "out"],
  "packages": {
    ".": {"name": "root", "layer": "stable-public", "allow": ["grammar", "tablegen", "runtime", "grammars", "internal/syntax"]},
    "compiler": {"name": "compiler", "layer": "offline", "allow": []},
    "internal/model": {"name": "model", "layer": "internal-model", "allow": []},
    "internal/regex": {"name": "regex", "layer": "internal", "allow": ["internal/model"]},
    "internal/grammar": {"name": "grammar-v1", "layer": "internal", "allow": ["internal/model", "internal/regex"]},
    "internal/automata": {"name": "automata", "layer": "internal", "allow": ["internal/model", "internal/regex", "internal/grammar"]},
    "internal/query_ir": {"name": "query-ir", "layer": "internal", "allow": ["internal/model"]},
    "internal/pack": {"name": "pack", "layer": "internal", "allow": ["internal/model"]},
    "internal/syntax": {"name": "syntax", "layer": "internal", "allow": ["internal/model"]},
    "internal/engine": {"name": "engine", "layer": "internal", "allow": ["internal/model", "internal/syntax"]},
    "internal/query_runtime": {"name": "query-runtime", "layer": "internal", "allow": ["internal/model", "internal/query_ir", "internal/syntax"]},
    "grammar": {"name": "grammar", "layer": "stable-public", "allow": []},
    "tablegen": {"name": "tablegen", "layer": "advanced", "allow": ["grammar"]},
    "runtime": {"name": "runtime", "layer": "stable-public", "allow": ["grammar", "tablegen"]},
    "query": {"name": "query", "layer": "stable-public", "allow": ["grammar", "tablegen", "runtime"]},
    "languagepack": {"name": "languagepack", "layer": "stable-public", "allow": ["grammar", "tablegen", "runtime", "query"]},
    "treesitterinterop": {"name": "treesitterinterop", "layer": "adapter", "allow": ["grammar", "query", "languagepack"]},
    "grammars": {"name": "grammars", "layer": "resource", "allow": ["grammar", "tablegen", "runtime", "languagepack"]},
    "wasm": {"name": "wasm", "layer": "adapter", "allow": ["grammar", "tablegen", "runtime", "query", "languagepack", "grammars"]},
    "cmd/main": {"name": "cmd", "layer": "application", "allow": ["grammar", "tablegen", "runtime", "query", "languagepack", "grammars", "treesitterinterop"]},
    "scripts": {"name": "scripts", "layer": "internal", "allow": ["grammar", "tablegen", "runtime", "grammars"]},
    "examples/api_smoke": {"name": "api-smoke", "layer": "compatibility-test", "allow": [".", "grammar", "tablegen", "runtime", "query"]},
    "tests/characterization": {"name": "characterization", "layer": "compatibility-test", "allow": [".", "languagepack", "query"]},
    "tests/contracts": {"name": "v1-contract-consumer", "layer": "compatibility-test", "allow": [".", "compiler"]}
  },
  "v1Contract": {
    "name": "MoonParse-v1-architecture",
    "packageGroups": {
      "root": ["."],
      "compiler": ["compiler"],
      "internal": ["internal/**"],
      "languages": ["languages/**"],
      "hosts": ["cmd/**", "wasm", "adapters/**", "demo/**"],
      "toolsAndTests": ["tools/**", "tests/**", "scripts", "examples/**", "bench/**"]
    },
    "rules": [
      {"id": "internal-must-not-depend-on-higher-layers", "from": "internal", "forbid": ["root", "compiler", "languages", "hosts", "toolsAndTests"]},
      {"id": "root-is-runtime-only", "from": "root", "forbid": ["compiler", "languages"]},
      {"id": "compiler-is-offline-only", "from": "compiler", "forbid": ["hosts"]},
      {"id": "languages-use-public-runtime-only", "from": "languages", "forbid": ["internal", "compiler", "hosts"]},
      {"id": "hosts-are-thin", "from": "hosts", "forbid": ["internal"]},
      {"id": "wasm-does-not-compile-grammar", "fromPaths": ["wasm"], "forbid": ["compiler", "internal/grammar", "internal/automata"]}
    ],
    "publicInterface": {
      "forbidTypePrefixes": ["internal/"],
      "rootOwns": ["Source", "ByteRange", "Point", "Span", "TextEdit", "Language", "KindId", "FieldId", "Parser", "ParseLimits", "Snapshot", "Node", "TreeCursor", "ChangedRange", "Diagnostic", "DiagnosticSeverity", "RecoveryAction", "ParseStats", "Query", "QueryRole", "Capture", "SourceError", "PackError", "ParseFailure", "QueryError"],
      "compilerOwns": ["PackManifest", "PackSource", "PackArtifact", "CompileOutput", "CompileDiagnostic", "CompileSeverity", "CompileSpan"]
    }
  }
}
