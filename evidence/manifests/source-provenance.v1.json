{
  "schema_version": 1,
  "policy": "deny-unrecorded-production-inputs",
  "assets": [
    {
      "id": "moonbit-corpus",
      "paths": ["languages/moonbit/corpus/**"],
      "origin": "repository-authored minimal syntax fixtures",
      "usage": "candidate production corpus",
      "release_disposition": "requires corpus manifest and hash freeze"
    },
    {
      "id": "experimental-language-fixtures",
      "paths": ["languages/json/**", "languages/python/**", "grammars/corpus/**"],
      "origin": "repository-authored minimal syntax fixtures",
      "usage": "experimental and compatibility testing",
      "release_disposition": "excluded unless separately promoted with source and license evidence"
    },
    {
      "id": "generated-interface-and-pack-assets",
      "paths": ["**/pkg.generated.mbti", "grammars/language_packs_generated.mbt", "wasm/build-info.json"],
      "origin": "repository generators",
      "usage": "generated compatibility metadata",
      "release_disposition": "rebuild from tracked source; never treat generated bytes as source of truth"
    },
    {
      "id": "website-tree-sitter-dev-dependencies",
      "paths": ["website/package-lock.json"],
      "origin": "npm registry lockfile",
      "usage": "development-only comparison workbench",
      "release_disposition": "excluded from champion runtime and release payload"
    }
  ],
  "required_fields_for_future_external_input": [
    "upstream_url",
    "license",
    "source_hash",
    "redistribution_basis",
    "release_disposition"
  ]
}
