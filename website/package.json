{
  "name": "moonparse-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync-runtime": "node scripts/sync-runtime.mjs",
    "sync-tree-sitter": "node scripts/sync-tree-sitter.mjs",
    "precompile": "node scripts/precompile-grammars.mjs",
    "test:corpus": "node src/test/run-corpus.mjs",
    "test:project": "node --test src/test/language-pack-project.test.mjs",
    "test:debugger": "node --test src/test/query-debugger.test.mjs",
    "test:conflicts": "node --test src/test/conflict-diagnostics.test.mjs",
    "test:incremental": "node --test src/test/incremental-trace.test.mjs",
    "test:url-state": "node --test src/test/url-state.test.mjs src/test/demo-scenarios.test.mjs",
    "test:vsix": "node --test src/test/vsix-artifact.test.mjs",
    "test:tree-sitter": "npm run sync-tree-sitter && node --test src/test/tree-sitter-compare.test.mjs",
    "test:lint": "node --test src/test/lint-workbench.test.mjs",
    "test:smoke": "node scripts/smoke-built.mjs",
    "test:c-tree": "node src/test/run-corpus.mjs c",
    "test:python-tree": "node src/test/run-corpus.mjs python",
    "dev": "vite",
    "build": "npm run sync-runtime && npm run sync-tree-sitter && node scripts/precompile-grammars.mjs && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "fflate": "^0.8.3",
    "mermaid": "^11.14.0",
    "tree-sitter-json": "^0.24.8",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4",
    "web-tree-sitter": "^0.26.10"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "vite": "^8.0.4"
  }
}
