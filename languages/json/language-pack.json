{
  "schemaVersion": 1,
  "id": "json",
  "name": "JSON",
  "version": "0.1.0",
  "maturity": "stable",
  "entryRule": "json",
  "extensions": [
    ".json"
  ],
  "compatibility": {
    "minimumMoonParseVersion": "0.1.0",
    "maximumMoonParseVersionExclusive": "0.2.0"
  },
  "grammar": {
    "path": "grammar/main.grammar",
    "format": "dsl"
  },
  "queries": {
    "highlights": "queries/highlights.scm"
  },
  "corpus": {
    "directory": "corpus",
    "format": "moonparse-corpus-v1"
  },
  "build": {
    "allowAmbiguousConflicts": false
  }
}
