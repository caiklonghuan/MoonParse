{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonparse.dev/schemas/language-bundle-v1.json",
  "title": "MoonParse Language Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "softwareVersion", "pack", "grammarJson", "parseTable", "queries", "scanner", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "softwareVersion": { "type": "string" },
    "pack": {
      "type": "object",
      "required": ["id", "version"],
      "properties": { "id": { "type": "string" }, "version": { "type": "string" } }
    },
    "grammarJson": { "type": "string" },
    "parseTable": {
      "type": "object",
      "required": ["schemaVersion", "json", "binaryBase64"],
      "properties": {
        "schemaVersion": { "enum": [3, 4] },
        "json": { "type": "string" },
        "binaryBase64": { "type": "string", "contentEncoding": "base64" }
      }
    },
    "queries": {
      "type": "object",
      "required": ["highlights", "locals", "bindings"],
      "properties": {
        "highlights": { "type": ["string", "null"] },
        "locals": { "type": ["string", "null"] },
        "bindings": { "type": ["string", "null"] },
        "folding": { "type": ["string", "null"] },
        "modules": { "type": ["string", "null"] }
      }
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleSets"],
      "properties": {
        "ruleSets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "enabledByDefault", "rules"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "enabledByDefault": { "type": "boolean" },
              "rules": {
                "type": "array",
                "items": { "$ref": "#/$defs/bundledLintRule" }
              }
            }
          }
        }
      }
    },
    "scanner": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["id", "apiVersion", "config"],
          "properties": {
            "id": { "type": "string" },
            "apiVersion": { "type": "integer", "minimum": 1 },
            "config": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "required": ["highlights", "locals", "bindings", "scanner"],
      "properties": {
        "highlights": { "type": "boolean" },
        "locals": { "type": "boolean" },
        "bindings": { "type": "boolean" },
        "folding": { "type": "boolean" },
        "modules": { "type": "boolean" },
        "lint": { "type": "boolean" },
        "rewrite": { "type": "boolean" },
        "scanner": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "capture": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "lintFix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "operation", "targetCapture", "template"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["replace", "delete", "insertBefore", "insertAfter"] },
        "targetCapture": { "$ref": "#/$defs/capture" },
        "template": { "type": "string" }
      }
    },
    "bundledLintRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabledByDefault", "severity", "message", "diagnosticCapture", "querySource", "fix"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "enabledByDefault": { "type": "boolean" },
        "severity": { "enum": ["hint", "information", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 },
        "diagnosticCapture": { "$ref": "#/$defs/capture" },
        "querySource": { "type": "string" },
        "fix": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/lintFix" }
          ]
        }
      }
    }
  }
}
