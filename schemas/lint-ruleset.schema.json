{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonparse.dev/schemas/lint-ruleset-v1.json",
  "title": "MoonParse Lint Ruleset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "enabledByDefault": { "type": "boolean", "default": true },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "packPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"
    },
    "capture": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "operation", "targetCapture", "template"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["replace", "delete", "insertBefore", "insertAfter"] },
        "targetCapture": { "$ref": "#/$defs/capture" },
        "template": { "type": "string" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "query", "severity", "message", "diagnosticCapture"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "query": { "$ref": "#/$defs/packPath" },
        "enabledByDefault": { "type": "boolean", "default": true },
        "severity": { "enum": ["hint", "information", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 },
        "diagnosticCapture": { "$ref": "#/$defs/capture" },
        "fix": { "$ref": "#/$defs/fix" }
      }
    }
  }
}
